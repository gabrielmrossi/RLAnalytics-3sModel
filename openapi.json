    "/api/analytics/v1/replays/{replay_id}/heatmap": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Get Replay Heatmap",
        "operationId": "get_replay_heatmap_api_analytics_v1_replays__replay_id__heatmap_get",
        "parameters": [
          {
            "name": "replay_id",
            "in": "path",
