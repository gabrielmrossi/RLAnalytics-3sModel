          },
          {
            "name": "entity",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "team",
                "ball"
              ],
              "type": "string",
              "default": "team",
              "title": "Entity"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "cells",
                "grid"
